{
  "manifest_version": 3,
  "name": "Download Manager Connector",
  "version": "1.0.0",
  "description": "Capture direct download links (HTTP, HTTPS, FTP) and send them to your Windows Download Manager app.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:45821/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Download Manager Connector",
    "default_popup": "popup.html"
  }
}
